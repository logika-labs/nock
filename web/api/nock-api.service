# /etc/systemd/system/nock-api.service: api.nock.dev (source: web/api in github.com/logika-labs/nock),
# on Logika's box behind Caddy (web/api/Caddyfile.snippet). The code is in /srv/nock-api, read-only to the
# service; the database in /var/lib/nock-api, the only place it may write.
[Unit]
Description=api.nock.dev: shared reflection summaries and usage reports
After=network.target

[Service]
User=nock-api
Group=nock-api
WorkingDirectory=/srv/nock-api
StateDirectory=nock-api
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /srv/nock-api/reflections.py --database /var/lib/nock-api/reflections.db --port 8610
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/nock-api
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
