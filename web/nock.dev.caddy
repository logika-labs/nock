# nock.dev on Logika's box: /etc/caddy/sites/nock.dev.caddy (installed by `python3 web/deploy.py HOST`), imported by
# the box's Caddyfile, which issues and renews the certificates. The pages are the release `current` names under
# /srv/sites/nock.dev. It serves a directory's index.html, the bare path redirected to the
# slashed one, files with their types; www.nock.dev redirects to nock.dev. No `log` directive: no access log.
nock.dev {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}
	encode zstd gzip
	root * /srv/sites/nock.dev/current
	header Cache-Control "no-cache"
	file_server
	handle_errors 404 {
		respond "Not found: nothing is at this address on nock.dev." 404
	}
}

www.nock.dev {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}
	redir https://nock.dev{uri} permanent
}
