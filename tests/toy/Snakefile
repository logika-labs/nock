# A toy: a word list in a git repository, a bug planted in it (a fork on
# `bug`), a detector per arm and repetition (a checkpoint), a fix only when
# the toolbox detected the bug, and a score joining both arms.
import json
from pathlib import Path

ARMS = ["control", "toolbox"]
REPS = [1, 2, 3]
BUGS = glob_wildcards("parameters/bug/{bug}.json").bug

wildcard_constraints:
    corpus="[^/]+",
    bug="[^/]+",
    arm="[^/]+",
    rep="[^/]+",


rule all:
    input:
        expand("results/score/bug={bug}/rep={rep}", bug=BUGS, rep=REPS),


rule build:
    input:
        "parameters/corpus/{corpus}.txt",
    output:
        directory("results/build/corpus={corpus}"),
    params:
        keyed=lambda wildcards: dict(wildcards),
    cache: "omit-software"
    script:
        "steps/build.py"


rule plant:
    input:
        state="results/build/corpus=fruit",
        bug="parameters/bug/{bug}.json",
    output:
        directory("results/plant/bug={bug}"),
    params:
        keyed=lambda wildcards: dict(wildcards),
    cache: "omit-software"
    script:
        "steps/plant.py"


checkpoint detect:
    input:
        "results/plant/bug={bug}",
    output:
        directory("results/detect/arm={arm}/bug={bug}/rep={rep}"),
    params:
        keyed=lambda wildcards: dict(wildcards),
    cache: "omit-software"
    resources:
        estimate_cents=10,
    script:
        "steps/detect.py"


def fix_when_detected(wildcards):
    """`when`: the fix runs only where the toolbox found the bug."""
    found = Path(checkpoints.detect.get(arm="toolbox", **wildcards).output[0], "metrics.json")
    detected = found.is_file() and json.loads(found.read_text()).get("detected")
    return [f"results/fix/bug={wildcards.bug}/rep={wildcards.rep}"] if detected else []


rule fix:
    input:
        state="results/plant/bug={bug}",
        detect="results/detect/arm=toolbox/bug={bug}/rep={rep}",
    output:
        directory("results/fix/bug={bug}/rep={rep}"),
    params:
        keyed=lambda wildcards: dict(wildcards),
    cache: "omit-software"
    script:
        "steps/fix.py"


rule score:
    input:
        control="results/detect/arm=control/bug={bug}/rep={rep}",
        toolbox="results/detect/arm=toolbox/bug={bug}/rep={rep}",
        fix=fix_when_detected,
    output:
        directory("results/score/bug={bug}/rep={rep}"),
    params:
        keyed=lambda wildcards: dict(wildcards),
    cache: "omit-software"
    script:
        "steps/score.py"
